# Copy this to .env on the server (never commit the real .env) and fill in real values.

# Your actual domain, DNS A record already pointed at this server's IP.
DOMAIN=lims.example.com

# Postgres — pick any values, these just become the credentials for the database
# this same server creates and manages.
POSTGRES_DB=gbclims
POSTGRES_USER=gbclims_app
POSTGRES_PASSWORD=change-me

# A long random string — generate one, don't reuse the value from any other
# environment (dev, Render, etc).
JWT_SECRET=change-me

# Set this to create the first admin account, log in once, then blank it out and
# redeploy (docker compose up -d --build) — it only works while there are zero users.
BOOTSTRAP_ADMIN_PASSWORD=
