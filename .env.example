# Copy this to .env on the server (never commit the real .env) and fill in real values.

# The subdomain this app is served on — a shared Caddy instance already owns the root
# domain and ports 80/443 on this host, so this app gets its own subdomain, not the bare
# domain. DNS A record for it should already point at this server's IP.
DOMAIN=lims.example.com

# Postgres — pick any values, these just become the credentials for the database
# this same server creates and manages. POSTGRES_USER becomes the cluster's bootstrap
# superuser (how the official postgres image's initdb works) — used only to run
# migrations (ConnectionStrings__MigrationsConnection in docker-compose.yml), never
# for normal app traffic.
POSTGRES_DB=gbclims
POSTGRES_USER=gbclims_owner
POSTGRES_PASSWORD=change-me

# The app's actual runtime role — genuinely restricted (not a superuser, unlike
# POSTGRES_USER above), created by scripts/setup-db-roles.sql after the first deploy.
# Every normal request runs as this role, including the one that matters: it cannot
# UPDATE/DELETE/TRUNCATE AuditLogs under any circumstance, not even by disabling the
# append-only trigger (that requires table ownership, which this role never has).
POSTGRES_APP_USER=gbclims_app
POSTGRES_APP_PASSWORD=change-me

# A long random string — generate one, don't reuse the value from any other
# environment (dev, Render, etc).
JWT_SECRET=change-me

# Set this to create the first admin account, log in once, then blank it out and
# redeploy (docker compose up -d --build) — it only works while there are zero users.
BOOTSTRAP_ADMIN_PASSWORD=
